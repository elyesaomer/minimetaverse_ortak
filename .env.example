# Mini Metaverse Sunucu Konfigürasyonu
PORT=3000

# MongoDB Bağlantı Adresi (MongoDB Atlas veya Yerel MongoDB linkinizi buraya yazın)
# Örnek Atlas Linki: mongodb+srv://kullaniciadi:sifre@cluster0.mongodb.net/mini_metaverse?retryWrites=true&w=majority
# Örnek Yerel Link: mongodb://127.0.0.1:27017/mini_metaverse
MONGO_URI=mongodb+srv://<kullanici_adi>:<sifre>@cluster0.example.mongodb.net/mini_metaverse?retryWrites=true&w=majority
